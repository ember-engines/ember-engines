{
  "name": "ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "ember-addon"
  ],
  "exports": {
    "./services/*": {
      "workspace-source": "./src/services/*.js",
      "default": "./dist/services/*.js"
    },
    "./components/*": {
      "workspace-source": "./src/components/*.gjs",
      "default": "./dist/components/*.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./_app_/*": "./dist/_app_/*.js"
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup --config"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./services/ui-intl.js": "./dist/_app_/services/ui-intl.js",
      "./components/ui-greeting.js": "./dist/_app_/components/ui-greeting.js"
    }
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.11.0",
    "decorator-transforms": "^2.4.0"
  },
  "peerDependencies": {
    "@glimmer/component": "^2.1.1",
    "ember-source": ">=7.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@embroider/addon-dev": "^8.5.0",
    "@glimmer/component": "^2.1.1",
    "@rollup/plugin-babel": "^7.1.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "ember-source": "~7.3.0",
    "rollup": "^4.63.3"
  }
}
