{
  "name": "blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "ember-addon",
    "ember-engine"
  ],
  "exports": {
    "./engine": {
      "workspace-source": "./src/engine.js",
      "default": "./dist/engine.js"
    },
    "./engine.js": {
      "workspace-source": "./src/engine.js",
      "default": "./dist/engine.js"
    },
    "./routes": {
      "workspace-source": "./src/routes.js",
      "default": "./dist/routes.js"
    },
    "./routes.js": {
      "workspace-source": "./src/routes.js",
      "default": "./dist/routes.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "start": "vite",
    "test": "vite build --mode development && testem ci --file testem.cjs"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "lazy-engine": true,
    "implicit-modules": [
      "./routes.js"
    ]
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.11.0",
    "comments": "workspace:*",
    "decorator-transforms": "^2.4.0",
    "ember-engines-runtime": "workspace:*",
    "ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@glimmer/component": "^2.1.1",
    "ember-source": ">=7.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/plugin-transform-runtime": "^8.1.2",
    "@babel/runtime": "^8.1.3",
    "@ember/test-helpers": "^5.4.3",
    "@embroider/core": "^4.6.10",
    "@embroider/macros": "^1.21.4",
    "@embroider/router": "^4.0.0",
    "@embroider/vite": "^1.8.1",
    "@glimmer/component": "^2.1.1",
    "@nullvoxpopuli/ember-rolldown": "3.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@tsdown/css": "0.23.7",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "ember-engines-router-service": "^0.7.0",
    "ember-qunit": "^9.1.0",
    "ember-source": "~7.3.0",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "sass-embedded": "^1.104.1",
    "testem": "^3.21.0",
    "tsdown": "0.23.7",
    "vite": "^8.3.8"
  }
}
